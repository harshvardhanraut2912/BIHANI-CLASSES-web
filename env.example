# ============================================================
# BihaniClasses - environment variables
# Local: copy to .env.local  |  Vercel: Settings -> Environment Variables
# NEVER commit real values. Generate secrets with:  openssl rand -hex 32
#
# [NEW]  = must be a brand-new value for this project
# [SAME] = may reuse the old YN Classes value (see notes)
# [AUTO] = Vercel injects it, do not add it yourself
# ============================================================


# ---------- 1. SUPABASE (new project) - ALL [NEW] ----------
NEXT_PUBLIC_SUPABASE_URL=https://onybcepeccuevhgqmrpl.supabase.co
# Project Settings -> API Keys -> anon / publishable key (public, safe in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API Keys -> secret / service_role key (server only, NEVER NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
# Some routes fall back to this name; same value as SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_KEY=
# Project Settings -> API / JWT -> JWT secret (used by lib/studentAuth.js)
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=onybcepeccuevhgqmrpl
# Account-level access token (Account -> Access Tokens). Not referenced by this
# project's code; keep only if some script of yours uses it.
SUPABASE_MANAGEMENT_TOKEN=


# ---------- 2. ADMIN / SESSION / INTERNAL SECRETS - ALL [NEW] ----------
# Signs admin session cookies. If reused, old-site admin sessions would be valid here.
ADMIN_SESSION_SECRET=
# Key required to create new admin accounts (/admin/addadmin)
ADMIN_PASSWORD_KEY=
APP_TEST_MODE_SECRET=
MAINTANANCE_PASS=
# Password for the transactions page; keep both consistent with each other
TRANSACTION_PASS=
TRANSACTION_PASS_B64=
# Protects /api/cron/* routes (cron is paused for now, but set it anyway)
CRON_SECRET=


# ---------- 3. PAYMENTS (Razorpay) ----------
# [SAME only if BihaniClasses uses the same Razorpay account; otherwise NEW]
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=


# ---------- 4. EMAIL ----------
# RESEND_API_KEY: [SAME] works, or [NEW] key for cleaner separation
RESEND_API_KEY=
# [NEW] once you own a bihaniclasses domain verified in Resend. Until then it
# must be a sender address verified in your Resend account.
EMAIL_FROM=
# Not referenced anywhere in the current code; only add if you actually use them
# GMAIL_USER=
# GMAIL_APP_PASSWORD=


# ---------- 5. TELEGRAM ----------
# Best [NEW] bot via @BotFather so alerts do not mix with YN Classes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# [NEW]; the bot webhook must be re-registered to the new site URL
TELEGRAM_WEBHOOK_SECRET=


# ---------- 6. GITHUB IMAGE HOSTING ----------
# [SAME] is fine for now: question images keep pointing at the old image repo.
GITHUB_TOKEN=
# Not read from env by the current code (repo owner/name/branch are set in code);
# add only if you later change the code to read them.
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_BRANCH=main


# ---------- 7. DO NOT ADD (Vercel injects these automatically) ----------
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_TARGET_ENV, VERCEL_OIDC_TOKEN,
# VERCEL_GIT_* (all of them), TURBO_*, NX_DAEMON
# VERCEL_TOKEN is not used by the code either; leave it out.
